 "charts": [
  {
   "file": "target_distribution.png",
   "title": "Target / class distribution",
   "section": "Target",
   "desc": "Left: the three original outcome values. Right: the binary target used for modelling. 40.7% of the cleaned patients were readmitted, so the classes are moderately imbalanced (ratio 1.45:1) - accuracy alone is not enough, which is why precision, recall, F1 and ROC-AUC are reported."
  },
  {
   "file": "missing_values.png",
   "title": "Missing values",
   "section": "Data quality",
   "desc": "Only a few columns contain missing values. weight is almost entirely missing and is dropped; payer_code and medical_specialty are partly missing and are kept with an explicit 'Unknown' category."
  },
  {
   "file": "feature_histogram.png",
   "title": "Histograms of numeric features",
   "section": "Distributions",
   "desc": "Shape of every numeric feature. Most utilisation counts (prior outpatient / emergency / inpatient visits, procedures) are heavily right-skewed: most patients have 0 or 1, a few have many. time_in_hospital and num_medications are right-skewed too."
  },
  {
   "file": "distribution_plots.png",
   "title": "Distribution plots by outcome",
   "section": "Distributions",
   "desc": "Density curves of key clinical numbers split by outcome. Large overlap between the two curves means the single feature separates the groups only weakly, which explains why readmission is a hard prediction problem."
  },
  {
   "file": "boxplot.png",
   "title": "Box plots by outcome (outliers)",
   "section": "Outliers",
   "desc": "Box plots show the median, quartiles and outliers (dots beyond 1.5 x IQR). number_outpatient has the largest share of outliers (13.0%). Outliers are real clinical cases (very long stays, many visits), so they are kept and handled by scaling and tree-based models rather than deleted."
  },
  {
   "file": "correlation_matrix.png",
   "title": "Correlation heatmap",
   "section": "Relationships",
   "desc": "Pearson correlation between numeric features and the target. The strongest feature-feature correlation is time_in_hospital vs num_medications (r = 0.468). The numeric feature most correlated with readmission is number_inpatient (r = 0.146) - correlations with the target are all weak, so models must combine many features."
  },
  {
   "file": "scatter_plot.png",
   "title": "Scatter plots",
   "section": "Relationships",
   "desc": "A random sample of 4,000 patients. Longer stays go together with more medications and lab procedures, but readmitted (red) and not-readmitted (blue) patients are heavily mixed - no simple boundary exists."
  },
  {
   "file": "age_readmission.png",
   "title": "Age and readmission",
   "section": "Categorical features",
   "desc": "Most patients are between 50 and 90 years old. The line shows how the percentage of readmitted patients changes with age band."
  },
  {
   "file": "count_plots.png",
   "title": "Count plots of categorical features",
   "section": "Categorical features",
   "desc": "Count of patients in the most frequent categories of eight categorical features, coloured by outcome. Compare the blue/red ratio between bars: categories where the red bar is relatively taller have a higher share of readmitted patients."
  },
  {
   "file": "prior_visits.png",
   "title": "Readmission rate vs prior inpatient visits",
   "section": "Target",
   "desc": "The readmission rate rises from 38% for patients with no prior inpatient stay to 84% for patients with five or more - prior hospital use is one of the clearest risk signals."
  },
  {
   "file": "pairplot.png",
   "title": "Pairwise relationships",
   "section": "Relationships",
   "desc": "Every combination of four key numeric features for a 1,500-patient sample. Diagonal: distribution per outcome. Off-diagonal: scatter plots. Considerable overlap again confirms that no pair of features alone separates the outcomes."
  }
 ]
